# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dados_rfb
DB_USER=rfb_user
DB_PASSWORD=95376a6b89720a684d3f88f71187721d

# API
PORT=3001

# Admin — chave para endpoints administrativos (seed-admin e ETL)
ADMIN_KEY=580a1b26c837e032d3f75e8a10c82904

# JWT — portal web (admin + cliente)
JWT_SECRET=mude-para-uma-chave-segura-em-producao

# ETL — diretório base no HOST (subpastas /downloads e /extraidos criadas automaticamente)
# Padrão: ./etl-data  (pasta local, ~25 GB necessários)
# Produção: aponte para volume dedicado, ex: /mnt/dados-rfb/etl
ETL_DATA_DIR=./etl-data

# Suporte — chat flutuante na landing page
SUPORTE_WHATSAPP=5511999999999        # DDI+DDD+numero, sem espaços
SUPORTE_ATENDENTE=Suporte BuscaDados
SUPORTE_MSG=Olá! Como posso te ajudar hoje? 👋
SUPORTE_EMAIL=suporte@buscadados.com.br

# SMTP — envio de e-mail do chat (opcional — se vazio, apenas loga)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=senha_app

# CRM — para integração reversa (opcional)
CRM_API_URL=http://localhost:3000
CRM_API_TOKEN=
